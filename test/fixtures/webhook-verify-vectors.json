{
    "description": "The result of the webhook verify function of each SDK. Give \"body\" as the raw body, \"headers\" as the request headers and \"now\" as the current Unix time. The tolerance is the default, 300 seconds. \"expect.valid\" true means that the function returns an event with this type, timestamp, delivery ID and data.id. \"expect.valid\" false means that the function raises the verification error with this reason.",
    "source": "BRIEF.md, \"Webhook verification\"",
    "secret": "test-webhook-secret-0123456789abcdefghij",
    "tolerance_seconds": 300,
    "cases": [
        {
            "name": "valid delivery",
            "body": "{\"event\":\"post.created\",\"data\":{\"id\":42,\"title\":\"Add dark mode\",\"content\":\"Users want a dark theme.\",\"status\":\"pending\",\"board_id\":1,\"contact_id\":null,\"stage\":null}}",
            "headers": {
                "X-FeedbackPilgrim-Event": "post.created",
                "X-FeedbackPilgrim-Delivery": "9b2f8f4e-3c1a-4d7e-9a51-2f0c6b8d1e44",
                "X-FeedbackPilgrim-Timestamp": "1763456789",
                "X-FeedbackPilgrim-Signature-V2": "2d4194d96e8fbc9affc0ff86526ba3a073d622702e09b68608bbf1fc073688e6"
            },
            "now": 1763456789,
            "expect": {
                "valid": true,
                "type": "post.created",
                "timestamp": 1763456789,
                "delivery_id": "9b2f8f4e-3c1a-4d7e-9a51-2f0c6b8d1e44",
                "data_id": 42
            }
        },
        {
            "name": "missing delivery header gives a null delivery ID",
            "body": "{\"event\":\"post.created\",\"data\":{\"id\":42,\"title\":\"Add dark mode\",\"content\":\"Users want a dark theme.\",\"status\":\"pending\",\"board_id\":1,\"contact_id\":null,\"stage\":null}}",
            "headers": {
                "X-FeedbackPilgrim-Event": "post.created",
                "X-FeedbackPilgrim-Timestamp": "1763456789",
                "X-FeedbackPilgrim-Signature-V2": "2d4194d96e8fbc9affc0ff86526ba3a073d622702e09b68608bbf1fc073688e6"
            },
            "now": 1763456789,
            "expect": {
                "valid": true,
                "type": "post.created",
                "timestamp": 1763456789,
                "delivery_id": null,
                "data_id": 42
            }
        },
        {
            "name": "empty delivery header gives a null delivery ID",
            "body": "{\"event\":\"post.created\",\"data\":{\"id\":42,\"title\":\"Add dark mode\",\"content\":\"Users want a dark theme.\",\"status\":\"pending\",\"board_id\":1,\"contact_id\":null,\"stage\":null}}",
            "headers": {
                "X-FeedbackPilgrim-Event": "post.created",
                "X-FeedbackPilgrim-Delivery": "",
                "X-FeedbackPilgrim-Timestamp": "1763456789",
                "X-FeedbackPilgrim-Signature-V2": "2d4194d96e8fbc9affc0ff86526ba3a073d622702e09b68608bbf1fc073688e6"
            },
            "now": 1763456789,
            "expect": {
                "valid": true,
                "type": "post.created",
                "timestamp": 1763456789,
                "delivery_id": null,
                "data_id": 42
            }
        },
        {
            "name": "uppercase hex signature is valid",
            "body": "{\"event\":\"post.created\",\"data\":{\"id\":42,\"title\":\"Add dark mode\",\"content\":\"Users want a dark theme.\",\"status\":\"pending\",\"board_id\":1,\"contact_id\":null,\"stage\":null}}",
            "headers": {
                "X-FeedbackPilgrim-Event": "post.created",
