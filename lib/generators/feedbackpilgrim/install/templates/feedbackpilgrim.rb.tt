# Feedback Pilgrim reads url, token, identity_secret and webhook_secret from
# Rails.application.credentials.feedbackpilgrim. Without credentials, it reads
# FEEDBACKPILGRIM_URL, FEEDBACKPILGRIM_TOKEN, FEEDBACKPILGRIM_IDENTITY_SECRET and
# FEEDBACKPILGRIM_WEBHOOK_SECRET.
FeedbackPilgrim.configure do |config|
